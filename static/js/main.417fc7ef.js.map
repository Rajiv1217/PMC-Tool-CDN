import React, { useEffect, useState } from "react";
import { Box, Stack, Typography, Button } from "@mui/material";
import { useAuth } from "../../Services/Auth";
import Icon from "../../Assets/files_icon.svg";
import Donut from "./donut";
import axios from "axios";
import axiosInstance from "../../Services/AxiosInstance";
import { getCookie } from "../../Services/Cookies";

const Row2comp = () => {
  const { setSelectedBtnSanc, selectedBtnSanc } = useAuth();
  const [apiRes, setApiRes] = useState([]);
  const [apiRes2, setApiRes2] = useState([]);

  useEffect(() => {
    const fetchData = async () => {
      const config = {
        headers: {
          email: getCookie("email2"),
          "access-token": getCookie("token"),
          Authorization: `Bearer ${getCookie("token")}`,
        },
      };
      const requestBody = {
        stateName: selectedBtnSanc,
      };

      try {
        const hardwareResponse = await axiosInstance.post(
          "budget/hardware",
          requestBody,
          config
        );
        if (hardwareResponse.status === 200) {
          console.log(hardwareResponse.data[0]);
          setApiRes(hardwareResponse.data[0]);
        } else {
          setApiRes([]);
        }
      } catch (error) {
        console.error("Error fetching hardware data:", error);
      }

      try {
        const siResponse = await axiosInstance.post(
          "budget/si",
          requestBody,
          config
        );
        if (siResponse.status === 200) {
          console.log(siResponse.data[0]);
          setApiRes2(siResponse.data[0]);
        } else {
          setApiRes2([]);
        }
      } catch (error) {
        console.error("Error fetching SI data:", error);
      }
    };

    fetchData();
  }, [selectedBtnSanc]);

  return (
    <>
      <Box
        sx={{
          backgroundColor: "#EEF4ED",
          padding: "2%",
          borderRadius: "4px",
        }}
      >
        <Stack direction="column">
          <Typography sx={{ fontFamily: "poppins" }}>
            {selectedBtnSanc}
          </Typography>
          <Typography
            sx={{
              fontFamily: "poppins",
              fontWeight: "bold",
              fontSize: "26px",
            }}
          >
            Hardware
          </Typography>
          <Stack
            sx={{ paddingTop: "10px" }}
            direction={{ xs: "column", md: "row" }}
            spacing={1}
          >
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="column"
            >
              <Typography
                sx={{
                  color: "#333333",
                  fontFamily: "poppins",
                  fontSize: "14px",
                  fontWeight: "600",
                }}
              >
                Workorder no. of Pacs
              </Typography>
              <Stack direction="row" sx={{ paddingTop: "10px" }} spacing={1}>
                <img src={Icon} alt="" style={{ width: "50px" }} />
                <Stack direction="column">
                  <Typography
                    sx={{
                      fontWeight: "bold",
                      color: "grey",
                      fontSize: "12px",
                    }}
                  >
                    PACS
                  </Typography>
                  <Typography
                    sx={{
                      color: "#065036",
                      fontWeight: "bold",
                      fontSize: "28px",
                    }}
                  >
                    {(apiRes && apiRes.workOrderNumberOfPacs) || "NaN"}
                  </Typography>
                </Stack>
              </Stack>
            </Stack>
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="column"
            >
              <Typography
                sx={{
                  color: "#333333",
                  fontFamily: "poppins",
                  fontSize: "14px",
                  fontWeight: "600",
                }}
              >
                Hardware Cost
              </Typography>
              <Stack direction="row" sx={{ paddingTop: "20px" }}>
                <img src={Icon} alt="" style={{ width: "50px" }} />
                <Stack direction="column">
                  <Typography
                    sx={{
                      fontWeight: "bold",
                      color: "grey",
                      fontSize: "12px",
                    }}
                  >
                    Hardware Cost
                  </Typography>
                  <Typography
                    sx={{
                      color: "#065036",
                      fontWeight: "bold",
                      fontSize: "26px",
                    }}
                  >
                    ₹&nbsp;{(apiRes && apiRes.hardwareCost) || "NaN"}
                  </Typography>
                </Stack>
              </Stack>
            </Stack>
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="row"
            >
              <Stack direction="column">
                <Typography
                  sx={{
                    color: "#333333",
                    fontFamily: "poppins",
                    fontSize: "14px",
                    fontWeight: "600",
                  }}
                >
                  Total Cost
                </Typography>
                <Stack direction="row" sx={{ paddingTop: "20px" }}>
                  <img src={Icon} alt="" style={{ width: "50px" }} />
                  <Stack direction="column">
                    <Typography
                      sx={{
                        fontWeight: "bold",
                        color: "grey",
                        fontSize: "12px",
                      }}
                    >
                      Total Cost
                    </Typography>
                    <Typography
                      sx={{
                        color: "#065036",
                        fontWeight: "bold",
                        fontSize: "28px",
                      }}
                    >
                      {(apiRes.totalCostOfHardware &&
                        apiRes.totalCostOfHardware.toFixed(2)) ||
                        "NaN"}
                      &nbsp;Cr.
                    </Typography>
                  </Stack>
                </Stack>
              </Stack>
              <Donut
                stateSharePercentage={
                  (apiRes && apiRes.stateSharePercentage) || 0
                }
                goiSharePercentage={(apiRes && apiRes.goiSharePercentage) || 0}
              />
            </Stack>
          </Stack>
          <Typography
            sx={{
              fontFamily: "poppins",
              fontWeight: "bold",
              fontSize: "26px",
              paddingTop: "5%",
            }}
          >
            SI Status
          </Typography>
          <Stack
            sx={{ paddingTop: "10px" }}
            direction={{ xs: "column", md: "row" }}
            spacing={1}
          >
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="column"
            >
              <Typography
                sx={{
                  color: "#333333",
                  fontFamily: "poppins",
                  fontSize: "14px",
                  fontWeight: "600",
                }}
              >
                No. of Sanctioned PACS
              </Typography>
              <Stack direction="row" sx={{ paddingTop: "10px" }} spacing={1}>
                <img src={Icon} alt="" style={{ width: "50px" }} />
                <Stack direction="column">
                  <Typography
                    sx={{ fontWeight: "bold", color: "grey", fontSize: "12px" }}
                  >
                    PACS
                  </Typography>
                  <Typography
                    sx={{
                      color: "#065036",
                      fontWeight: "bold",
                      fontSize: "28px",
                    }}
                  >
                    {(apiRes2 && apiRes2.numberOfSanctionedPacs) || "NaN"}
                  </Typography>
                </Stack>
              </Stack>
            </Stack>
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="column"
            >
              <Typography
                sx={{
                  color: "#333333",
                  fontFamily: "poppins",
                  fontSize: "14px",
                  fontWeight: "600",
                }}
              >
                SI cost per PACS
              </Typography>
              <Stack direction="row" sx={{ paddingTop: "20px" }} spacing={1}>
                <img src={Icon} alt="" style={{ width: "50px" }} />
                <Stack direction="column">
                  <Typography
                    sx={{ fontWeight: "bold", color: "grey", fontSize: "12px" }}
                  >
                    Hardware Cost
                  </Typography>
                  <Typography
                    sx={{
                      color: "#065036",
                      fontWeight: "bold",
                      fontSize: "28px",
                    }}
                  >
                    ₹&nbsp;{(apiRes2 && apiRes2.siCost) || "NaN"}
                  </Typography>
                </Stack>
              </Stack>
            </Stack>
            <Stack
              sx={{
                backgroundColor: "#F7FCF7",
                padding: "10px",
                borderRadius: "6px",
              }}
              direction="row"
            >
              <Stack direction="column">
                <Typography
                  sx={{
                    color: "#333333",
                    fontFamily: "poppins",
                    fontSize: "14px",
                    fontWeight: "600",
                  }}
                >
                  Total Cost
                </Typography>
                <Stack direction="row" sx={{ paddingTop: "20px" }} spacing={1}>
                  <img src={Icon} alt="" style={{ width: "50px" }} />
                  <Stack direction="column">
                    <Typography
                      sx={{
                        fontWeight: "bold",
                        color: "grey",
                        fontSize: "12px",
                      }}
                    >
                      Total Cost
                    </Typography>
                    <Typography
                      sx={{
                        color: "#065036",
                        fontWeight: "bold",
                        fontSize: "28px",
                      }}
                    >
                      {(apiRes2.totalCostOfSi &&
                        apiRes2.totalCostOfSi.toFixed(2)) ||
                        "NaN"}
                      &nbsp;Cr.
                    </Typography>
                  </Stack>
                </Stack>
              </Stack>
              <Donut
                stateSharePercentage={
                  (apiRes2 && apiRes2.stateSharePercentage) || 0
                }
                goiSharePercentage={
                  (apiRes2 && apiRes2.goiSharePercentage) || 0
                }
              />
            </Stack>
          </Stack>
        </Stack>
      </Box>
    </>
  );
};

export default Row2comp;
